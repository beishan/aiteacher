# 将此文件复制为 Jenkins 的 Secret file 凭据。
# 建议凭据 ID：tutor-assist-production-env。不要提交包含真实密码的生产环境文件。

DB_NAME=tutor_assist
DB_USER=tutor_assist
DB_PASSWORD=请替换为强数据库密码
JWT_SECRET=请替换为至少32字节的随机JWT密钥
ONLYOFFICE_JWT_SECRET=请替换为独立的OnlyOffice随机密钥

TZ=Asia/Shanghai

# 以下地址必须填写飞牛 NAS 的局域网 IP/域名，不能写 localhost。
ONLYOFFICE_PUBLIC_URL=http://192.168.31.155:8283
BACKEND_PUBLIC_URL=http://192.168.31.155:8282

# 可按 NAS 端口占用情况修改；Jenkins 构建参数会覆盖前后端端口。
FRONTEND_PORT=8281
BACKEND_PORT=8282
ONLYOFFICE_PORT=8283
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
